{
  "name": "periodic-tables-2026-back-end",
  "type": "module",
  "version": "1.0.0",
  "description": "Modernized version of my 2021 Thinkful keystone project - back end",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run --reporter=verbose --passWithNoTests",
    "migrate:latest": "kysely migrate:latest",
    "migrate:rollback": "kysely migrate:rollback",
    "migrate:status": "kysely migrate:status"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/zod-validator": "^0.9.0",
    "hono": "^4.13.2",
    "kysely": "^0.29.5",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "kysely-ctl": "^0.21.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "author": "Rott Kitchell"
}
